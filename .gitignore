# SPCBPT-OptiX7 local development ignores

# Build trees (out-of-source)
/build/
/build-*/
/src/build/

# In-source CMake pollution (rejected by the root CMakeLists; ignored as a safety net)
/CMakeCache.txt
/CMakeFiles/
/cmake_install.cmake
/compile_commands.json
/src/CMakeCache.txt
/src/CMakeFiles/
/src/CMakeScripts/
/src/cmake_install.cmake
/src/compile_commands.json
/src/*.sln
/src/*.vcxproj*
/src/ALL_BUILD*
/src/ZERO_CHECK*
/src/INSTALL*
/src/RUN_TESTS*
/src/Nightly*
/src/Continuous*
/src/Experimental*
/src/DartConfiguration.tcl
/src/Testing/
/src/bin/
/src/x64/
/src/Win32/
/src/Debug/
/src/Release/
/src/RelWithDebInfo/
/src/MinSizeRel/

# CMake user overrides (machine-local OptiX/Ninja paths, etc.)
/CMakeUserPresets.json
/src/CMakeUserPresets.json

# IDE / editor
.vs/
.vscode/
*.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb

# Local planning / agent working notes (do not upload)
.planning/
.tmpDir/

# OS junk
Thumbs.db
Desktop.ini
__pycache__/
*.py[cod]

# Runtime-generated local state and diagnostics
/imgui.ini
/renderer.json
/renderer_config.json
/*_pt.txt
/*_lvcbpt.txt
/*_lvcbpt_proxy_experimental.txt
/*_lvcbpt+lighttrace.txt
.DS_Store
